+                scrollable: false,
+                columns: [
+                    { field: "tgl", title: "Waktu / Tgl EMR", width: "160px" },
+                    { field: "tekanandarah", title: "TD (mmHg)", width: "100px", attributes: { style: "text-align: center" } },
+                    { field: "nadi", title: "Nadi (x/m)", width: "90px", attributes: { style: "text-align: center" } },
